\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mdcstyle}[2026/09/30 Modern Digital Communications book style]

% ---------------------------------------------------------------- fonts & basics
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[sc,osf]{mathpazo}          % Palatino text + math
\RequirePackage[scaled=0.90]{helvet}       % sans for headings and boxes
\RequirePackage{courier}
\linespread{1.06}
\RequirePackage{microtype}
\RequirePackage[letterpaper,inner=1.05in,outer=1.25in,top=1in,bottom=1.05in,
                headheight=14pt,marginparwidth=0.9in]{geometry}
\RequirePackage{amsmath,amssymb,amsthm,bm,mathtools}
\RequirePackage{graphicx,xcolor,booktabs,tabularx,array,multirow,siunitx}
\RequirePackage{enumitem,caption,subcaption,float,placeins}
\RequirePackage{tikz,pgfplots}
\pgfplotsset{compat=1.18}
\usetikzlibrary{arrows.meta,positioning,shapes.geometric,shapes.misc,calc,fit,backgrounds,decorations.pathreplacing,patterns}
\RequirePackage[most]{tcolorbox}
\RequirePackage{listings}
\RequirePackage{fancyhdr,titlesec,tocloft,emptypage}
\RequirePackage{imakeidx}
\RequirePackage[hyperfootnotes=false]{hyperref}
\RequirePackage{bookmark}

% ---------------------------------------------------------------- palette
\definecolor{navy}{HTML}{1B3A5C}
\definecolor{accent}{HTML}{C0392B}
\definecolor{histc}{HTML}{8B5A2B}
\definecolor{histbg}{HTML}{FBF5EC}
\definecolor{practc}{HTML}{1E7B4F}
\definecolor{practbg}{HTML}{EEF8F2}
\definecolor{keyc}{HTML}{1F5F9E}
\definecolor{keybg}{HTML}{EDF3FA}
\definecolor{labc}{HTML}{C0661A}
\definecolor{labbg}{HTML}{FDF3EA}
\definecolor{warnc}{HTML}{A93226}
\definecolor{warnbg}{HTML}{FBEEEC}
\definecolor{workc}{HTML}{4A4A6A}
\definecolor{workbg}{HTML}{F4F4F8}
\definecolor{codebg}{HTML}{F7F7F7}

\hypersetup{colorlinks=true,linkcolor=navy,urlcolor=accent,citecolor=practc,
  pdfauthor={},pdftitle={Modern Digital Communications},bookmarksnumbered=true,
  bookmarksopen=true,bookmarksopenlevel=1,pdfstartview=Fit,pdfpagemode=UseOutlines}

% ---------------------------------------------------------------- headings
\newcommand{\sffamilybold}{\sffamily\bfseries}
\titleformat{\chapter}[display]
  {\sffamily\color{navy}}
  {\begin{tikzpicture}[remember picture,overlay]
     \node[anchor=north east,inner sep=0pt] at ($(current page.north east)+(-0.9in,-0.75in)$)
       {\fontsize{90}{90}\selectfont\color{navy!18}\bfseries\thechapter};
   \end{tikzpicture}\normalsize\color{accent}\MakeUppercase{\chaptertitlename}}
  {6pt}
  {\bfseries\fontsize{26}{30}\selectfont\raggedright}
  [\vspace{4pt}{\color{accent}\titlerule[1.2pt]}]
\titlespacing*{\chapter}{0pt}{30pt}{28pt}
\titleformat{\section}{\sffamily\Large\bfseries\color{navy}}{\thesection}{0.8em}{}
\titleformat{\subsection}{\sffamily\large\bfseries\color{navy!85}}{\thesubsection}{0.8em}{}
\titleformat{\subsubsection}{\sffamily\normalsize\bfseries\color{navy!75}}{}{0em}{}
\titleformat{\part}[display]{\centering\sffamily\color{navy}}
  {\Large\color{accent}\MakeUppercase{\partname}~\thepart}{14pt}{\bfseries\fontsize{30}{36}\selectfont}
\setcounter{secnumdepth}{2}
\setcounter{tocdepth}{1}

% ---------------------------------------------------------------- headers/footers
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\chaptermark}[1]{\markboth{\thechapter.\ #1}{}}
\renewcommand{\sectionmark}[1]{\markright{\thesection\ \ #1}}
\fancyhead[LE]{\sffamily\small\color{navy}\leftmark}
\fancyhead[RO]{\sffamily\small\color{navy}\rightmark}
\fancyfoot[LE,RO]{\sffamily\small\bfseries\color{navy}\thepage}
\fancyfoot[C]{\sffamily\tiny\color{gray}\hyperlink{toc}{Contents}}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{{\color{navy!40}\hrule height\headrulewidth width\headwidth}}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\sffamily\small\bfseries\color{navy}\thepage}\renewcommand{\headrulewidth}{0pt}}

% ---------------------------------------------------------------- TOC look
\renewcommand{\cftchapfont}{\sffamily\bfseries\color{navy}}
\renewcommand{\cftchappagefont}{\sffamily\bfseries\color{navy}}
\renewcommand{\cftpartfont}{\sffamily\bfseries\large\color{accent}}
\renewcommand{\cftpartpagefont}{\sffamily\bfseries\large\color{accent}}
\renewcommand{\cftsecfont}{\small}
\renewcommand{\cftsecpagefont}{\small}
\setlength{\cftbeforechapskip}{5pt}

% ---------------------------------------------------------------- captions, lists
\captionsetup{font=small,labelfont={sf,bf,color=navy},format=hang,margin=10pt}
\setlist{itemsep=2pt,topsep=4pt}
\numberwithin{equation}{chapter}
\numberwithin{figure}{chapter}
\numberwithin{table}{chapter}

% ---------------------------------------------------------------- boxes
% Box titles accept either [Title] or [title=Title]; the key form is stripped here.
\RequirePackage{xstring}
\newcommand{\mdcbt}[1]{\noexpandarg\IfBeginWith{#1}{title=}{\StrBehind{#1}{title=}}{#1}}
\tcbset{mdcbase/.style={enhanced,breakable,boxrule=0pt,leftrule=3pt,arc=0pt,outer arc=0pt,
   left=8pt,right=8pt,top=6pt,bottom=6pt,before skip=10pt,after skip=10pt,
   fonttitle=\sffamily\bfseries\small,coltitle=white,attach title to upper={}}}
\newtcolorbox{history}[1][]{mdcbase,colback=histbg,colframe=histc,
   title={\textcolor{histc}{\sffamily\bfseries\small HISTORY\quad \mdcbt{#1}}\par\smallskip},
   detach title,before upper={\tcbtitle}}
\newtcolorbox{inpractice}[1][]{mdcbase,colback=practbg,colframe=practc,
   title={\textcolor{practc}{\sffamily\bfseries\small IN PRACTICE\quad \mdcbt{#1}}\par\smallskip},
   detach title,before upper={\tcbtitle}}
\newtcolorbox{keyidea}[1][]{mdcbase,colback=keybg,colframe=keyc,
   title={\textcolor{keyc}{\sffamily\bfseries\small KEY IDEA\quad \mdcbt{#1}}\par\smallskip},
   detach title,before upper={\tcbtitle}}
\newtcolorbox{labbox}[1][]{mdcbase,colback=labbg,colframe=labc,
   title={\textcolor{labc}{\sffamily\bfseries\small SIMULATION LAB\quad \mdcbt{#1}}\par\smallskip},
   detach title,before upper={\tcbtitle}}
\newtcolorbox{pitfall}[1][]{mdcbase,colback=warnbg,colframe=warnc,
   title={\textcolor{warnc}{\sffamily\bfseries\small PITFALL\quad \mdcbt{#1}}\par\smallskip},
   detach title,before upper={\tcbtitle}}
\newtcolorbox{worked}[1][]{mdcbase,colback=workbg,colframe=workc,
   title={\textcolor{workc}{\sffamily\bfseries\small WORKED EXAMPLE\quad \mdcbt{#1}}\par\smallskip},
   detach title,before upper={\tcbtitle}}

% chapter-opening summary
\newtcolorbox{chapterintro}{enhanced,colback=navy!4,colframe=navy!4,arc=0pt,boxrule=0pt,
   left=10pt,right=10pt,top=8pt,bottom=8pt,fontupper=\sffamily\small,before skip=0pt,after skip=16pt}

% ---------------------------------------------------------------- code
\lstdefinestyle{py}{language=Python,basicstyle=\ttfamily\footnotesize,backgroundcolor=\color{codebg},
  keywordstyle=\color{navy}\bfseries,commentstyle=\color{practc}\itshape,stringstyle=\color{accent},
  frame=l,framerule=2pt,rulecolor=\color{navy!40},xleftmargin=10pt,framexleftmargin=6pt,
  showstringspaces=false,breaklines=true,columns=fullflexible,keepspaces=true,
  literate={α}{{$\alpha$}}1 {β}{{$\beta$}}1 {μ}{{$\mu$}}1 {°}{{$^\circ$}}1}
\lstset{style=py}

% ---------------------------------------------------------------- math shortcuts
\newcommand{\E}{\mathbb{E}}
\newcommand{\R}{\mathbb{R}}
\newcommand{\C}{\mathbb{C}}
\newcommand{\Q}{\mathrm{Q}}
\newcommand{\ebno}{E_b/N_0}
\newcommand{\esno}{E_s/N_0}
\newcommand{\dB}{\,\mathrm{dB}}
\newcommand{\sinc}{\operatorname{sinc}}
\newcommand{\re}{\operatorname{Re}}
\newcommand{\im}{\operatorname{Im}}
\newcommand{\vect}[1]{\mathbf{#1}}
\newcommand{\term}[1]{\textbf{#1}\index{#1}}
\newcommand{\figpath}[1]{figs/#1}
\newcommand{\lab}[1]{\texttt{#1}}

% standard figure from the generated set
\newcommand{\mdcfig}[3][0.92]{%
  \begin{figure}[htbp]\centering\includegraphics[width=#1\linewidth]{figs/#2}\caption{#3}\label{fig:#2}\end{figure}}

% chapter end: problems header
\newcommand{\problems}{\section*{Problems}\addcontentsline{toc}{section}{Problems}}
\newcommand{\furtherreading}{\section*{Further Reading}\addcontentsline{toc}{section}{Further Reading}}

\makeindex[intoc,columns=2,title=Index]

\endinput
